[Unit]
Description=Moose Detector - Thermal Camera YOLO Detection
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
User=moose
WorkingDirectory=/home/moose/projects/MooseDetector
# Set PYTHONPATH so 'moosedetector' package is importable from src/
Environment=PYTHONPATH=/home/moose/MooseDetector/src
# Required for cv2.imshow to find the display
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/moose/.Xauthority
Environment=LD_LIBRARY_PATH=/home/moose/projects/ThermalCameraSDK/Seek_Thermal_SDK_4.4.2.20/aarch64-linux-gnu/lib
ExecStart=/home/moose/projects/MooseDetector/venv/bin/python3 /home/moose/projects/MooseDetector/src/main.py
# Restart automatically if the process crashes
# Restart=on-failure
# RestartSec=5
# Log stdout/stderr to the systemd journal (view with: journalctl -u moosedetector)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
