[Unit]
Description=Moose Detector - Thermal Camera YOLO Detection
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/MooseDetector

# Set PYTHONPATH so 'moosedetector' package is importable from src/
Environment=PYTHONPATH=/home/pi/MooseDetector/src
# Required for cv2.imshow to find the display
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority

ExecStart=/usr/bin/python3 /home/pi/MooseDetector/src/main.py

# Restart automatically if the process crashes
Restart=on-failure
RestartSec=5

# Log stdout/stderr to the systemd journal (view with: journalctl -u moosedetector)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
